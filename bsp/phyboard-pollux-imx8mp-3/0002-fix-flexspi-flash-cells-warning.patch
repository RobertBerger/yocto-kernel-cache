From 2130c3d6184188ffcccf34b81cab7989fbd4b748 Mon Sep 17 00:00:00 2001
From: Robert Berger <Robert.Berger@ReliableEmbeddedSystems.com>
Date: Mon, 14 Sep 2026 11:51:36 +0000
Subject: [PATCH] fix flexspi flash cells warning

Signed-off-by: Robert Berger <Robert.Berger@ReliableEmbeddedSystems.com>
Upstream-Status: Inappropriate [Product-specific - needed to avoid kernel flexspi flash cells warning]
---
 arch/arm64/boot/dts/freescale/imx8mp-phycore-som.dtsi | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-phycore-som.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-phycore-som.dtsi
index 04f724c6e..09a1327c5 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-phycore-som.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-phycore-som.dtsi
@@ -84,6 +84,9 @@ som_flash: flash@0 {
 		spi-max-frequency = <80000000>;
 		spi-rx-bus-width = <4>;
 		spi-tx-bus-width = <1>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
 	};
 };
 
